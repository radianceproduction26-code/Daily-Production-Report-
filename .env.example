# Radiance Polymers – Production Report System v1.0.0
# Environment Configuration Template
# Copy this file to .env and fill in your values.
# DO NOT commit the actual .env file to version control.

# ─── SUPABASE CLOUD SYNC (OPTIONAL) ──────────────────────────────────────────
# Leave blank to run in fully offline-first localStorage mode.
# Fill in only if you want automatic cloud backup and multi-device sync.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ─── APP CONFIG ───────────────────────────────────────────────────────────────
# Displayed in the app header and exported reports
VITE_APP_NAME=Radiance Polymers Production Report
VITE_APP_VERSION=1.0.0
VITE_PLANT_NAME=Radiance Polymers

# ─── PILOT CONFIGURATION ──────────────────────────────────────────────────────
# Pilot machine locked for Version 1.0 trial
VITE_PILOT_MACHINE=MC03
VITE_TRIAL_DURATION_DAYS=21

# ─── EMAIL CONFIGURATION (OPTIONAL) ──────────────────────────────────────────
# Used by the Daily Production Summary Email feature.
# These can also be set from the Admin Settings screen inside the app.
# If left blank, email dispatch falls back to manual Excel/PDF export.
VITE_EMAIL_SMTP_HOST=
VITE_EMAIL_SMTP_PORT=587
VITE_EMAIL_SMTP_USER=
VITE_EMAIL_SMTP_PASS=
VITE_EMAIL_FROM_NAME=Radiance Polymers MC03
VITE_EMAIL_FROM_ADDRESS=
# Comma-separated list of default recipient email addresses
VITE_EMAIL_RECIPIENTS=

# ─── BACKUP CONFIGURATION (OPTIONAL) ─────────────────────────────────────────
# How many days to retain shift reports in localStorage (0 = unlimited)
VITE_RETENTION_DAYS=90
